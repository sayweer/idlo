# apps/pilot/.env — PİLOT (ajan) ayarları (SPEC Ek B). Gerçek değerler yalnız .env'e; asla git'e değil.
# PILOT_AGENT cüzdanının özel anahtarı (requestBuy için)
PILOT_AGENT_PRIVATE_KEY=
# KULE MCP uç noktası
KULE_URL=https://kule.ALANADI.com/mcp
# KULE'nin bu ajana verdiği bearer token
PILOT_TOKEN=
# PİLOT'un LLM'i (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Opsiyonel: Pyth Hermes (fiyat bandı); anahtarsız istek 401 dönüyor
PYTH_HERMES_URL=
PYTH_API_KEY=
# 1 = injection demosu açık (ekranda etiketlenir; hiçbir korumayı kapatmaz)
INJECTION_DEMO=0
# Kayıt oynatma dosyası (örn. data/replays/2025-03-19.json); boşsa canlı veri
REPLAY=
# Fuji RPC (örn. https://api.avax-test.network/ext/bc/C/rpc)
FUJI_RPC=
# Deploy çıktısı (adresler)
DEPLOYMENTS=../../deployments/fuji.json
