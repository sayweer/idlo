# apps/kule/.env — KULE (OKX kapısı) ayarları (SPEC Ek B). Gerçek değerler yalnız .env'e; asla git'e değil.
# MCP sunucu portu (yalnız 127.0.0.1'e bağlanır; dışarıya Caddy üzerinden)
KULE_PORT=8787

# ── Token → ajan bağı (§9.2-1) ──
# Her token tek bir ajan adresine bağlıdır; bir izni yalnız o planın agent adresine bağlı token uygulayabilir.
# Token: 16–128 karakter (harf, rakam, ._~+/=-); `openssl rand -hex 24` gibi bir şeyle üret.
# PİLOT ajanının bearer token'ı ve bağlı olduğu ajan adresi (deployments/fuji.json pilotAgent ile aynı olmalı)
PILOT_TOKEN=
PILOT_AGENT_ADDRESS=
# Demo istemcisinin bearer token'ı. Ajan adresi verilmezse yalnız okuma/teklif araçlarını kullanabilir
# (kule_execute WRONG_AGENT döner). TODO(spec): Ek B'de ajan adresi yok.
DEMO_CLIENT_TOKEN=
DEMO_CLIENT_AGENT_ADDRESS=
# İsteğe bağlı ek ajanlar (çok ajanlı yön): "token:0xadres,token:0xadres". Ajan başına tek token.
AGENT_TOKENS=

# Kullanıcının cüzdan adresi (§14 USER): KULE yalnız bu adresin planına bağlı izinleri uygular (packages/shared/authz.ts). TODO(spec): Ek B'de yok
PLAN_USER_ADDRESS=

# ── ATK / OKX ──
# ATK profili: kule-demo | kule (~/.okx/config.toml). kule-demo için OKX_DEMO=1, kule için OKX_DEMO=0 olmalı (çelişirse KULE açılmaz).
OKX_PROFILE=kule-demo
# Yürütme modu: okx | paper (paper ekranda "KÂĞIT" diye etiketlenir; borsaya emir gitmez)
KULE_EXEC=okx
# Yalnız Cancel-All-After REST çağrısı için (okx modunda zorunlu); ATK ~/.okx/config.toml'u okur. İzin: Read + Trade, Withdraw YOK.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = OKX demo işlem
OKX_DEMO=1

# ── Zincir (Fuji) ──
# KULE_REPORTER cüzdanının özel anahtarı (reportExecution için); adresi deployments/fuji.json kuleReporter ile aynı olmalı
KULE_REPORTER_PRIVATE_KEY=
# Fuji RPC (örn. https://api.avax-test.network/ext/bc/C/rpc); düz http yalnız 127.0.0.1 için
FUJI_RPC=
# Deploy çıktısı (adresler, deployBlock); yol apps/kule'ye göre
DEPLOYMENTS=../../deployments/fuji.json
