# apps/kule/.env — KULE (OKX kapısı) ayarları (SPEC Ek B). Gerçek değerler yalnız .env'e; asla git'e değil.
# MCP sunucu portu (yalnız 127.0.0.1'e bağlanır; dışarıya Caddy üzerinden)
KULE_PORT=8787
# PİLOT ajanının bearer token'ı (token→ajan bağı, §9)
PILOT_TOKEN=
# Demo istemcisinin bearer token'ı
DEMO_CLIENT_TOKEN=
# Kullanıcının cüzdan adresi (§14 USER): KULE yalnız bu adresin planına bağlı izinleri uygular (boş ya da geçersizse hiçbir izin uygulanmaz; packages/shared/authz.ts). TODO(spec): Ek B'de yok
PLAN_USER_ADDRESS=
# PILOT_TOKEN'ın bağlı olduğu ajan adresi (§9.2-1 token→ajan bağı). TODO(spec): Ek B'de yok
PILOT_AGENT_ADDRESS=
# ATK profili: kule-demo | kule (~/.okx/config.toml)
OKX_PROFILE=kule-demo
# Yürütme modu: okx | paper (paper ekranda "KÂĞIT" diye etiketlenir)
KULE_EXEC=okx
# Yalnız Cancel-All-After REST çağrısı için; ATK ~/.okx/config.toml'u okur. İzin: Read + Trade, Withdraw YOK.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = OKX demo işlem
OKX_DEMO=1
# KULE_REPORTER cüzdanının özel anahtarı (reportExecution için)
KULE_REPORTER_PRIVATE_KEY=
# Fuji RPC (örn. https://api.avax-test.network/ext/bc/C/rpc)
FUJI_RPC=
# Deploy çıktısı (adresler)
DEPLOYMENTS=../../deployments/fuji.json
