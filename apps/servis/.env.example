# apps/servis/.env — OKX.AI servisleri (SPEC Ek B). Servis borsa anahtarı TUTMAZ; yalnız herkese açık piyasa verisi.
# Servis portu (yalnız 127.0.0.1'e bağlanır; dışarıya Caddy üzerinden)
SERVIS_PORT=8790
# true = temsili x402 ödeme (ekranda etiketlenir)
MOCK_OKX_FACILITATOR=true
# İstek başı ücret (USDG)
X402_PRICE=0.01
# Ödemeyi alacak adres
PAYMENT_RECIPIENT=
# Onchain OS Dev Portal anahtarları (yalnız gerçek x402 modunda; borsa anahtarı DEĞİL)
OKX_WEB3_API_KEY=
OKX_WEB3_SECRET_KEY=
OKX_WEB3_PASSPHRASE=
