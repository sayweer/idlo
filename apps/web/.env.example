# apps/web/.env — Web uygulaması (SPEC Ek B). Gerçek değerler yalnız .env'e; asla git'e değil.
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider: buraya gizli bilgi YAZMA.
NEXT_PUBLIC_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_DEPLOYMENTS_URL=/deployments/fuji.json
# Plan çevirisi (/api/plan/draft) için LLM — yalnız sunucu tarafı
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Mutabakat için salt-okunur OKX anahtarı (izin: yalnız Read; KULE anahtarından ayrı) — yalnız sunucu tarafı
OKX_READONLY_API_KEY=
OKX_READONLY_SECRET=
OKX_READONLY_PASSPHRASE=
# 1 = /demo sayfası açık (ekranda etiketlenir)
DEMO=1
