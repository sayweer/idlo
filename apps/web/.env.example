# apps/web/.env — Web uygulaması. Gerçek değerler yalnız .env'e; asla git'e değil.
# VITE_ ile başlayanlar tarayıcıya gider: buraya gizli bilgi YAZMA.
VITE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
